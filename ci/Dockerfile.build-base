ARG GO_IMAGE=registry.jingan.com:32008/ja/golang:1.27.3-bookworm
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS tools
ARG TARGETOS
ARG TARGETARCH
ARG GOVULNCHECK_VERSION=v1.9.0
ARG GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
ENV GOTOOLCHAIN=local GOPROXY=$GOPROXY
# The official bookworm Go image already includes Python 3 and OpenSSL.
# Cross-compile the extra tool so the arm64 image requires no emulation.
RUN command -v python3 && command -v openssl \
    && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOPATH=/tmp/rttys-tools \
       go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION} \
    && mkdir /out \
    && if [ "$TARGETOS/$TARGETARCH" = "$(go env GOHOSTOS)/$(go env GOHOSTARCH)" ]; then \
         cp /tmp/rttys-tools/bin/govulncheck /out/; \
       else \
         cp /tmp/rttys-tools/bin/${TARGETOS}_${TARGETARCH}/govulncheck /out/; \
       fi

FROM ${GO_IMAGE} AS build-base
COPY --from=tools /out/govulncheck /usr/local/bin/govulncheck
ENV GOTOOLCHAIN=local
LABEL org.opencontainers.image.source="https://github.com/gtja/ja-rttys" \
      org.opencontainers.image.description="Go 1.27.3, Python 3, OpenSSL and govulncheck v1.9.0 for ja-rttys CI"
